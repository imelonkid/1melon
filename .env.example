# 服务端（apps/server）的配置。复制为 .env 后填写。真实值在 1Password「ops/1melon/prod」，.env 不进 git。
# 每个变量写一行注释：用途、格式、是否必填。

# 运行环境：dev | prod（必填）
APP_ENV=dev
# 监听端口（可选，默认 8790）
PORT=8790
# 监听的 IP（可选，默认留空 = 所有网卡）。容器里留空，由 compose 映射到宿主机 127.0.0.1；本机直接运行时填 127.0.0.1，只让本机连
BIND_ADDR=
# 数据目录（容器内，可选，默认 /data）。SQLite 库 1melon.db 放这里，开 WAL
DATA_DIR=/data
# 日志级别：debug | info | warn | error（可选，默认 info）
LOG_LEVEL=info
# 反向代理写真实客户端 IP 的请求头（线上 tx-1 openresty 写 X-Real-IP，填 X-Real-IP）；留空 = 用连接地址。限流按它算，没有反向代理时不要填，否则能伪造
TRUSTED_PROXY_HEADER=

# —— 可观测（规范 §8）——
# OTel Collector 地址；留空 = 不导出（运维中心 Collector 就位后再填）
OTEL_EXPORTER_OTLP_ENDPOINT=
