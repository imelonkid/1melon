# 服务端（apps/server）的配置。复制为 .env 后填写。真实值在 1Password「ops/1melon/prod」，.env 不进 git。
# 每个变量写一行注释：用途、格式、是否必填。

# 运行环境：dev | prod（必填）
APP_ENV=dev
# 监听端口（可选，默认 8790）
PORT=8790
# 监听的 IP（可选，默认留空 = 所有网卡）。容器里留空，由 compose 映射到宿主机 127.0.0.1；本机直接运行时填 127.0.0.1，只让本机连
BIND_ADDR=
# 数据目录（容器内，可选，默认 /data）。SQLite 库 1melon.db 放这里，开 WAL
DATA_DIR=/data
# 日志级别：debug | info | warn | error（可选，默认 info）
LOG_LEVEL=info
# 反向代理写真实客户端 IP 的请求头（线上 tx-1 openresty 写 X-Real-IP，填 X-Real-IP）；留空 = 用连接地址。限流按它算，没有反向代理时不要填，否则能伪造
TRUSTED_PROXY_HEADER=

# —— 异云备份：Litestream 持续复制 data/1melon.db（compose 的 litestream 容器）——
# vault 桶和区域（必填）。桶按规范 §7 命名 mk-vault-<站点>，值以运维仓库注册表为准
LITESTREAM_OSS_BUCKET=
# 桶所在区域，例如 cn-beijing（必填）
LITESTREAM_OSS_REGION=
# 桶里的路径（必填）：<主站点>/litestream/1melon.db，主站点 tx 时填 tx/litestream/1melon.db
LITESTREAM_OSS_PATH=tx/litestream/1melon.db
# 写入子账号 vault-writer-<站点> 的 AccessKey（必填，真实值在 1Password backup/<桶>/）。只能写这个前缀
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# —— 可观测（规范 §8）——
# OTel Collector 地址；留空 = 不导出（运维中心 Collector 就位后再填）
OTEL_EXPORTER_OTLP_ENDPOINT=
