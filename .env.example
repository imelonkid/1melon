# 服务端（apps/server）的配置。复制为 .env 后填写。真实值在 1Password「ops/1melon/prod」，.env 不进 git。
# 每个变量写一行注释：用途、格式、是否必填。

# 运行环境：dev | prod（必填）
APP_ENV=dev
# 监听端口（可选，默认 8790）
PORT=8790
# 数据目录（容器内，可选，默认 /data）。SQLite 库 1melon.db 放这里，开 WAL
DATA_DIR=/data
# 日志级别：debug | info | warn | error（可选，默认 info）
LOG_LEVEL=info

# —— 可观测（规范 §8）——
# OTel Collector 地址；留空 = 不导出（运维中心 Collector 就位后再填）
OTEL_EXPORTER_OTLP_ENDPOINT=
